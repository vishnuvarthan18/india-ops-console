# Copy to .env on the VPS and fill in. Never commit .env.

# Postgres — same database the core API uses, but a read-mostly role.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ops_console
POSTGRES_PASSWORD=
POSTGRES_DB=india_data

# Admin login. Generate the hash with:
#   docker compose run --rm ops-console python -m app.auth hash
# Store ONLY the hash here. The plaintext password is never written to disk.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Signs the login session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this logs everyone out, which is the intended way to revoke sessions.
SESSION_SECRET=

SESSION_MAX_AGE_HOURS=12
OPS_CONSOLE_ENV=production
LOG_LEVEL=INFO

# Where the host metrics collector drops its JSON (see ops/scripts/collect_metrics.sh).
METRICS_FILE=/var/ops-metrics/metrics.json

# Directory containing the checked-out repos, mounted read-only, used to
# render each engine's DECISIONS.md.
REPOS_DIR=/repos
