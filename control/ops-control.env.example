# Install to /etc/ops-control/ops-control.env, owned by root, mode 0600.
#
# Generate the token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The SAME value goes in the console's .env as CONTROL_TOKEN.
CONTROL_TOKEN=
CONTROL_PORT=8011
CONTROL_ALLOWLIST=/etc/ops-control/units.allow
CONTROL_KEYVARS=/etc/ops-control/keyvars.allow
CONTROL_SECRETS_FILE=/home/ubuntu/core-infra/.env
